# Voice Assistant Configuration
# Copy this to .env and customize

# Debug mode (verbose logging)
DEBUG=false

# Enable/disable voice output
VOICE_ENABLED=true

# TTS Engine: pyttsx3, espeak
TTS_ENGINE=espeak

# STT Engine: termux, google, pocketsphinx
STT_ENGINE=termux

# Require confirmation for destructive commands
CONFIRM_DESTRUCTIVE=true

# Disable all internet features (local-only mode)
LOCAL_ONLY=false

# Optional API Keys
GMAIL_API_KEY=
OPENWEATHER_API_KEY=
NEWSAPI_KEY=
CRYPTO_API_KEY=

# Optional Groq conversational AI
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
